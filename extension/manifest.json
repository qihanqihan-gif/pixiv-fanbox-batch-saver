{
  "manifest_version": 3,
  "name": "画师文件夹下载器",
  "version": "0.3.38",
  "description": "把某位 Fanbox / Pixiv 画师的全部作品，按「总文件夹/作品文件夹/文件」直接写进你选择的目录（手机可用，绕开浏览器下载层的平铺限制）。",
  "action": {
    "default_title": "画师文件夹下载器",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": ["tabs", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["*://*.fanbox.cc/*", "*://*.pixiv.net/*", "*://*.pximg.net/*"],
  "content_scripts": [
    {
      "matches": ["*://*.fanbox.cc/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.pixiv.net/*"],
      "js": ["pixiv.js"],
      "run_at": "document_idle"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "pixiv-referer",
        "enabled": true,
        "path": "rules-pixiv.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["app.html", "app.js", "app.css"],
      "matches": ["*://*.fanbox.cc/*", "*://*.pixiv.net/*"]
    }
  ],
  "options_page": "app.html"
}
